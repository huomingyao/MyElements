  { "id": "tip_o2", "style": "bubble", "duration": 3.0, "once": true, "text": "氧气 O₂——空气中的氧气约占 21%，动植物呼吸都需要它" },
  { "id": "tip_h2", "style": "bubble", "duration": 3.0, "once": true, "text": "氢气 H₂——最轻的气体，最清洁的燃料，但点燃前必须验纯！" },
  { "id": "tip_c", "style": "bubble", "duration": 3.0, "once": true, "text": "碳 C——木头燃烧剩下的木炭，主要成分就是碳" },
  { "id": "tip_s", "style": "bubble", "duration": 3.0, "once": true, "text": "硫 S——淡黄色粉末，易燃，燃烧时有刺激性气味" },
  { "id": "tip_co", "style": "bubble", "duration": 3.0, "once": true, "text": "一氧化碳 CO——无色无味的剧毒气体，煤气中毒的元凶！" },
  { "id": "tip_co2", "style": "bubble", "duration": 3.0, "once": true, "text": "二氧化碳 CO₂——不燃烧也不支持燃烧，能使澄清石灰水变浑浊" },
  { "id": "tip_h2o", "style": "bubble", "duration": 3.0, "once": true, "text": "天然水含杂质——需净化后才能用于实验" },
  { "id": "tip_h2o_clean", "style": "bubble", "duration": 3.0, "once": true, "text": "蒸馏水是纯净物——沉淀→过滤→吸附→蒸馏，净化四步" },
  { "id": "tip_caco3", "style": "bubble", "duration": 3.0, "once": true, "text": "碳酸钙 CaCO₃——石灰石、大理石的主要成分" },
  { "id": "tip_fe2o3", "style": "bubble", "duration": 3.0, "once": true, "text": "氧化铁 Fe₂O₃——赤铁矿的主要成分，炼铁的原料" },
  { "id": "tip_cuso4", "style": "bubble", "duration": 3.0, "once": true, "text": "硫酸铜 CuSO₄——蓝色溶液，重金属盐有毒，别碰！" },
  { "id": "tip_hcl", "style": "bubble", "duration": 3.0, "once": true, "text": "盐酸 HCl——有腐蚀性，但也是除锈和制 CO₂ 的好帮手" },
  { "id": "tip_naoh", "style": "bubble", "duration": 3.0, "once": true, "text": "氢氧化钠 NaOH——俗称烧碱、火碱、苛性钠，强腐蚀性" },
  { "id": "tip_caoh2", "style": "bubble", "duration": 3.0, "once": true, "text": "氢氧化钙 Ca(OH)₂——熟石灰，其水溶液就是澄清石灰水" },
  { "id": "tip_fe", "style": "bubble", "duration": 3.0, "once": true, "text": "铁 Fe——最常见的金属，生锈需要氧气和水同时存在" },
  { "id": "tip_crude_salt", "style": "bubble", "duration": 3.0, "once": true, "text": "粗盐——主要成分是氯化钠，但混有泥沙等杂质，需提纯后才能用" },
  { "id": "tip_nacl", "style": "bubble", "duration": 3.0, "once": true, "text": "氯化钠 NaCl——由钠离子和氯离子构成，厨房里的食盐就是它" }
